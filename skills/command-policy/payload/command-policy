#!/usr/bin/env node
// housekeep command-policy — PreToolUse/Bash hook engine.
//
// Reads the PreToolUse hook payload on stdin, extracts the Bash command, splits it
// into segments, resolves each segment's binary to its real on-disk path, and
// evaluates per-tool JSON policy (deny -> ask -> deferInAuto -> rewrite -> allow ->
// default). Emits a PreToolUse permissionDecision. Verdict precedence across
// segments: deny > ask > deferInAuto > allow. Anything it cannot confidently parse
// fails CLOSED to `deferInAuto` (prompt interactively, pass through in auto).
//
// Verdict tiers (strongest first):
//   deny        - hard block, every mode. Agent cannot run it.
//   ask         - always prompt, every mode INCLUDING auto.
//   deferInAuto - prompt in interactive modes; in "auto" mode pass through when
//                 env COMMAND_POLICY_DEFER_IN_AUTO is set (else behaves like ask).
//   allow       - silent.
//
// Config: <script-dir>/config/<tool>.json (installed at
// ${CLAUDE_CONFIG_DIR:-~/.claude}/command-policy/config/). Schema:
//   { "tool": "git", "binaries": ["/usr/bin/git"],
//     "default": "allow"|"ask"|"deferInAuto"|"abstain",
//     "deny":        [ {"argv": <matcher>, "reason": "" } ],
//     "ask":         [ ... ],
//     "deferInAuto": [ ... ],
//     "rewrite":     [ {"argv": <matcher>, "to": "sandbox-run python3",
//                       "wrap": "sandbox-run", "fallbackTo": "<old wrapper>", "reason": "" } ],
//     "allow":       [ ... ],
//     "wrapSafe":    true|false }
// Matchers (against argv AFTER argv[0]); a matcher object may carry MULTIPLE keys,
// ALL of which must hold (AND); at least one key is required:
//   contains:      every listed token present as an argv token (any position)
//   notContains:   none of the listed tokens present
//   prefix:        leading argv tokens deep-equal the list
//   exact:         full argv deep-equals the list
//   regex:         space-joined argv matches the JS RegExp string
//   scratchScript: (bool) a positional (non-"-") arg resolves to a path under a
//                  scratch root (/tmp, /private/tmp, /var/folders, $TMPDIR)
//
// The `rewrite` bucket transparently swaps a segment's command word for `to`
// (a sandboxed runner, e.g. `sandbox-run python3`) and emits allow +
// hookSpecificOutput.updatedInput so the sandboxed command runs with no prompt.
// Rewrite fires only when EVERY segment is managed (never greenlights unmanaged
// parts of a compound).
//
// `wrap` names the shared runner behind `to`. When several segments need it, the
// whole command runs inside it once (`<wrap> sh -c '<command>'`) — provided every
// other segment is an allowed segment of a `wrapSafe` (read-only) config and
// nothing redirects to a file; otherwise the command is denied with instructions
// to split it (the same runner twice in one pipeline hangs). If `wrap` is not on
// PATH (a session started before the runner existed), `fallbackTo` is spliced
// per segment instead.

'use strict';
const fs = require('fs');
const path = require('path');

const SELF_DIR = __dirname;
const CONFIG_DIR = process.env.COMMAND_POLICY_CONFIG_DIR || path.join(SELF_DIR, 'config');
const CLAUDE_CONFIG_DIR = process.env.CLAUDE_CONFIG_DIR || path.join(process.env.HOME || '', '.claude');
// Dirs to exclude from PATH resolution so we find the REAL binary, not a shim.
const SHIM_DIRS = [
  path.join(process.env.HOME || '', '.claude', 'shims'), // legacy shim dir (may not exist post-retirement) — still stripped defensively
  path.join(CLAUDE_CONFIG_DIR, 'command-policy'),
];
// Scratch roots for scratchScript detection (agent-authored throwaway scripts).
const SCRATCH_ROOTS = ['/tmp/', '/private/tmp/', '/var/folders/', '/private/var/folders/']
  .concat(process.env.TMPDIR ? [process.env.TMPDIR.replace(/\/?$/, '/')] : []);
// The one directory sandboxed interpreter code may write (named in deny messages).
const SCRATCH_DIR = process.env.COMMAND_POLICY_SCRATCH_DIR
  || path.join(process.env.HOME || '', '.command-policy', 'scratch');

// ---- IO -------------------------------------------------------------------

function readStdin() {
  try {
    return fs.readFileSync(0, 'utf8');
  } catch (_) {
    return '';
  }
}

// Abstain: exit 0 with no output -> control falls through to the normal
// permission-rule evaluation unchanged. Used for unmanaged commands and for
// compound commands that mix managed-safe with unmanaged segments (so we never
// emit a blanket allow that would greenlight the unmanaged parts too).
function abstain() {
  process.exit(0);
}

// Emit a PreToolUse decision. NOTE (per Claude Code semantics): a hook
// "ask"/"deny" is only effective when no permissions.allow entry matches the
// command; a matching allow entry wins. Therefore git is fully hook-owned — no
// overlapping git allow entry may exist. A hook "allow" skips the prompt only
// when no deny/ask rule matches. `updatedInput`, when provided, replaces the
// tool input (used to transparently rewrite the command word to a boxed wrapper).
function emit(decision, reason, updatedInput) {
  const out = {
    hookSpecificOutput: {
      hookEventName: 'PreToolUse',
      permissionDecision: decision,             // "allow" | "ask" | "deny"
      permissionDecisionReason: reason || '',
    },
  };
  if (updatedInput) out.hookSpecificOutput.updatedInput = updatedInput;
  process.stdout.write(JSON.stringify(out));
  process.exit(0);
}

// ---- Parsing --------------------------------------------------------------

// Sentinels standing in for the *value* of an expansion. The body is analyzed
// (see parse); the value itself is not knowable at hook time.
//   SUBST_Q - quoted expansion ("$(…)", "`…`"), arithmetic $((…)), or process
//             substitution <(…): NO word splitting, so it contributes exactly ONE
//             argv token. Treated like a plain `$VAR` — unknown string, known
//             command shape — and so is not a policy blocker.
//   SUBST   - unquoted $(…) / `…`: the value is word-split and globbed, so it can
//             expand into an ARBITRARY argv list (`git $(printf 'push --force')`).
//             The shape of the command is unknown -> main() fails closed.
const NUL = String.fromCharCode(0);
const SUBST = NUL + 'subst' + NUL;
const SUBST_Q = NUL + 'substq' + NUL;

// Guard against pathological nesting (also stops runaway recursion on malformed
// input); exceeding it is treated as unparseable -> fail closed.
const MAX_NEST = 32;

// Tokenize a Bash string into segments (split on top-level | && || ; &) while
// respecting single/double quotes and backslash escapes. Each token is
// { v: value, s: startOffset, e: endOffset } where [s,e) is the token's byte
// range in the original command (including any quotes) — used to splice the
// command word during rewrite. Returns { segments: [[tok,...], ...], unparseable }.
//
// Substitutions are NOT opaque. `$(...)`, backticks, `<(...)`/`>(...)` and bare
// `( ... )` subshell groups all contain command lists that REALLY EXECUTE, so the
// body is parsed recursively and its segments land in the same flat `segments`
// list as the outer command — with absolute offsets, so rewrite splices stay
// valid inside a substitution. That is the point of the recursion: `echo "$(rm
// -rf ~)"` and `$( (rm -rf /) )` reach rm's deny rules, and substitutions nested
// in double quotes are seen at all (they previously read as literal text).
//
// The substitution's RESULT is unknown, so it contributes SUBST (unquoted, may
// word-split into an arbitrary argv) or SUBST_Q (quoted/arithmetic/process
// substitution — exactly one token) to the enclosing token. See the sentinel
// comments above for how main() treats each.
//
// Heredoc bodies (`<<EOF` / `<<-EOF` / `<<'EOF'`) are DATA and are skipped, not
// tokenized — otherwise `git commit -m "$(cat <<'EOF' … EOF )"` would have its
// commit message parsed as a command list. A body under an UNQUOTED delimiter does
// undergo expansion, so a substitution in there fails closed.
//
// unparseable is set only on genuinely unbalanced input: an unterminated quote,
// substitution or heredoc, or nesting past MAX_NEST.
function parse(command) {
  const segments = [];
  const n = command.length;
  let unparseable = false;
  let i = 0;

  // `$((expr))` — arithmetic expansion. No command runs, so just skip to the
  // matching close paren. Enter with i at the `$`. Returns false on EOF.
  function skipArith() {
    i += 1; // past `$`, leaving i on the first `(`
    let depth = 0;
    while (i < n) {
      const c = command[i];
      if (c === '(') depth++;
      else if (c === ')') { depth--; if (depth === 0) { i++; return true; } }
      i++;
    }
    return false;
  }

  // Tokenize a command list from i until `close` (or EOF when close is null),
  // appending its segments to `segments`. Callers that capture the list's stdout
  // into a token append SUBST themselves. Returns false when the input turned out
  // to be unparseable.
  function scanList(close, depth) {
    if (depth > MAX_NEST) { unparseable = true; return false; }
    let cur = [];
    let tok = '';
    let hasTok = false;
    let tokStart = -1;

    const start = (pos) => { if (!hasTok) tokStart = pos; };
    const pushTok = () => { if (hasTok) { cur.push({ v: tok, s: tokStart, e: i }); tok = ''; hasTok = false; tokStart = -1; } };
    const pushSeg = () => { pushTok(); if (cur.length) segments.push(cur); cur = []; };

    while (i < n) {
      const c = command[i];

      if (close && c === close) { pushSeg(); i++; return true; }

      // Expansions whose value lands in the current token.
      if (c === '$' && command[i + 1] === '(' && command[i + 2] === '(') {
        start(i);
        if (!skipArith()) { unparseable = true; return false; }
        tok += SUBST_Q; hasTok = true; continue;
      }
      if (c === '$' && command[i + 1] === '(') {
        start(i); i += 2;
        if (!scanList(')', depth + 1)) return false;
        tok += SUBST; hasTok = true; continue;
      }
      if (c === '`') {
        start(i); i += 1;
        if (!scanList('`', depth + 1)) return false;
        tok += SUBST; hasTok = true; continue;
      }
      if ((c === '<' || c === '>') && command[i + 1] === '(') {
        start(i); i += 2;
        if (!scanList(')', depth + 1)) return false;
        tok += SUBST_Q; hasTok = true; continue;   // /dev/fd path: one token
      }
      // `<<<` herestring: a 3-char operator taking a WORD (not a heredoc body).
      // Consumed whole so the scanner never re-reads its tail as a `<<` heredoc;
      // the word that follows is scanned normally, so its expansions still recurse.
      if (c === '<' && command[i + 1] === '<' && command[i + 2] === '<') {
        start(i); tok += '<<<'; hasTok = true; i += 3; continue;
      }

      // Heredoc redirect: the body is DATA, not a command list.
      if (c === '<' && command[i + 1] === '<') {
        const opStart = i;
        let j = i + 2;
        const stripTabs = command[j] === '-';
        if (stripTabs) j++;
        while (j < n && (command[j] === ' ' || command[j] === '\t')) j++;
        let delim = '';
        let expands = true;                 // unquoted delimiter -> body expands
        if (command[j] === "'" || command[j] === '"') {
          const q = command[j];
          const end = command.indexOf(q, j + 1);
          if (end === -1) { unparseable = true; return false; }
          delim = command.slice(j + 1, end); expands = false; j = end + 1;
        } else {
          const m = /^[^\s;|&()<>]+/.exec(command.slice(j));
          if (m) { delim = m[0]; j += delim.length; }
        }
        if (!delim) { start(i); tok += c; hasTok = true; i++; continue; } // not a heredoc
        // Body runs from the next newline to a line that is exactly the delimiter.
        const nl = command.indexOf('\n', j);
        if (nl === -1) { unparseable = true; return false; }
        const lines = command.slice(nl + 1).split('\n');
        let consumed = 0;
        let closed = false;
        const body = [];
        for (const line of lines) {
          consumed += line.length + 1;      // +1 for the newline
          if ((stripTabs ? line.replace(/^\t+/, '') : line) === delim) { closed = true; break; }
          body.push(line);
        }
        if (!closed) { unparseable = true; return false; }
        // An unquoted delimiter expands the body, so a substitution in there really
        // runs; that is not statically analyzable here -> fail closed.
        if (expands && /\$\(|`/.test(body.join('\n'))) { unparseable = true; return false; }
        start(opStart);
        tok += command.slice(opStart, j);   // keep `<<EOF` as a redirect-ish token
        hasTok = true;
        i = Math.min(nl + 1 + consumed, n);
        continue;
      }

      // Bare `( ... )` subshell group — only when it starts a word, so an array
      // literal (`paths=(a b)`) keeps its old literal treatment. Its commands run
      // but its stdout is not captured, so no SUBST.
      if (c === '(' && !hasTok) {
        pushSeg(); i += 1;
        if (!scanList(')', depth + 1)) return false;
        continue;
      }

      if (c === '\\') { // escape next char literally
        if (i + 1 < n) { start(i); tok += command[i + 1]; hasTok = true; i += 2; continue; }
        i++; continue;
      }
      if (c === "'") { // single-quoted: literal until next ' (no expansion in bash)
        const end = command.indexOf("'", i + 1);
        if (end === -1) { unparseable = true; return false; }
        start(i); tok += command.slice(i + 1, end); hasTok = true; i = end + 1; continue;
      }
      if (c === '"') { // double-quoted: honor \ escapes AND nested substitutions
        start(i); i += 1;
        let closed = false;
        while (i < n) {
          const d = command[i];
          if (d === '"') { i += 1; closed = true; break; }
          if (d === '\\' && i + 1 < n) { tok += command[i + 1]; i += 2; continue; }
          if (d === '$' && command[i + 1] === '(' && command[i + 2] === '(') {
            if (!skipArith()) { unparseable = true; return false; }
            tok += SUBST_Q; continue;
          }
          if (d === '$' && command[i + 1] === '(') {
            i += 2;
            if (!scanList(')', depth + 1)) return false;
            tok += SUBST_Q; continue;
          }
          if (d === '`') {
            i += 1;
            if (!scanList('`', depth + 1)) return false;
            tok += SUBST_Q; continue;
          }
          tok += d; i += 1;
        }
        if (!closed) { unparseable = true; return false; }
        hasTok = true; continue;
      }

      // Operators (outside quotes) -> segment boundaries.
      if (c === '&') {
        // `>&` fd-duplication (2>&1, >&2, 1>&2, 2>&-) is a redirect, not an
        // operator: keep the `&` attached to the current token (stripped later).
        // `&&` (logical) and lone `&` (background) stay segment boundaries.
        if (command[i + 1] !== '&' && hasTok && tok.endsWith('>')) { tok += c; i++; continue; }
        pushSeg();
        i += (command[i + 1] === '&') ? 2 : 1; // && vs lone &
        continue;
      }
      if (c === '|') {
        pushSeg();
        i += (command[i + 1] === '|') ? 2 : 1; // || vs |
        continue;
      }
      if (c === ';') { pushSeg(); i++; continue; }
      if (c === ' ' || c === '\t' || c === '\n' || c === '\r') { pushTok(); i++; continue; }

      start(i); tok += c; hasTok = true; i++;
    }

    if (close) { unparseable = true; return false; } // unterminated substitution
    pushSeg();
    return true;
  }

  scanList(null, 0);
  return { segments, unparseable };
}

// Drop leading VAR=val environment assignments. Returns argv (argv[0] = command)
// as token objects.
function stripEnv(tokens) {
  let k = 0;
  while (k < tokens.length && /^[A-Za-z_][A-Za-z0-9_]*=/.test(tokens[k].v)) k++;
  return tokens.slice(k);
}

// Drop fd-duplication / fd-close redirect tokens (2>&1, >&2, 1>&2, 2>&-). These
// perform no file write, so they are noise for policy matching. File-writing
// redirects (>, >>, 2>file, &>file) are deliberately NOT stripped — they keep
// their normal (unmatched -> abstain -> prompt) treatment.
function stripRedirects(tokens) {
  return tokens.filter((t) => !/^\d*>&\d*-?$/.test(t.v));
}

// ---- Resolution -----------------------------------------------------------

function realpathSafe(p) {
  try { return fs.realpathSync(p); } catch (_) { return p; }
}

// Whether a bare command name is runnable in this session. Unlike resolveBinary,
// shim dirs count: a nono command edge exists only as a shim on PATH.
function onPath(name) {
  for (const dir of (process.env.PATH || '').split(':').filter(Boolean)) {
    try { fs.accessSync(path.join(dir, name), fs.constants.X_OK); return true; } catch (_) {}
  }
  return false;
}

function resolveBinary(arg0) {
  if (arg0.includes('/')) return realpathSafe(arg0);
  const parts = (process.env.PATH || '').split(':').filter(Boolean)
    .filter((d) => !SHIM_DIRS.includes(d));
  for (const dir of parts) {
    const cand = path.join(dir, arg0);
    try { fs.accessSync(cand, fs.constants.X_OK); return realpathSafe(cand); } catch (_) {}
  }
  return arg0; // unresolved; fall back to bare name
}

// ---- Config + matching ----------------------------------------------------

function loadConfigs() {
  const byTool = {};
  const byBinary = {};
  let files = [];
  try { files = fs.readdirSync(CONFIG_DIR).filter((f) => f.endsWith('.json')); } catch (_) {}
  for (const f of files) {
    try {
      const cfg = JSON.parse(fs.readFileSync(path.join(CONFIG_DIR, f), 'utf8'));
      if (cfg.tool) byTool[cfg.tool] = cfg;
      for (const b of cfg.binaries || []) byBinary[realpathSafe(b)] = cfg;
    } catch (_) {}
  }
  return { byTool, byBinary };
}

function configFor(realPath, arg0, cfgs) {
  if (cfgs.byBinary[realPath]) return cfgs.byBinary[realPath];
  const base = path.basename(realPath || arg0);
  if (cfgs.byTool[base]) return cfgs.byTool[base];
  const base0 = path.basename(arg0);
  if (cfgs.byTool[base0]) return cfgs.byTool[base0];
  return null;
}

// Does any positional (non-flag) arg resolve to a path under a scratch root?
function isScratchScript(args) {
  for (const a of args) {
    if (!a || a.startsWith('-')) continue;
    let p = a;
    if (!p.startsWith('/')) { try { p = path.resolve(p); } catch (_) { continue; } }
    for (const r of SCRATCH_ROOTS) { if (p.startsWith(r)) return true; }
  }
  return false;
}

// A matcher object may carry multiple keys; ALL present keys must hold (AND).
// At least one key is required (an empty matcher never matches).
function matches(rule, args) {
  const a = rule.argv || {};
  let any = false;
  if ('contains' in a) { any = true; if (!a.contains.every((t) => args.includes(t))) return false; }
  if ('notContains' in a) { any = true; if (a.notContains.some((t) => args.includes(t))) return false; }
  if ('prefix' in a) { any = true; if (!(a.prefix.length <= args.length && a.prefix.every((t, i) => args[i] === t))) return false; }
  if ('exact' in a) { any = true; if (!(a.exact.length === args.length && a.exact.every((t, i) => args[i] === t))) return false; }
  if ('regex' in a) { any = true; try { if (!new RegExp(a.regex).test(args.join(' '))) return false; } catch (_) { return false; } }
  if ('scratchScript' in a) { any = true; if (a.scratchScript && !isScratchScript(args)) return false; }
  return any;
}

// Evaluate one config against args -> { decision, reason, to? }. Bucket order
// (strongest first): deny > ask > deferInAuto > rewrite > allow > default.
//   deny        - hard block, every mode.
//   ask         - always prompt, every mode (including auto).
//   deferInAuto - prompt in interactive modes; pass through in "auto" mode when
//                 COMMAND_POLICY_DEFER_IN_AUTO is set (else behaves like ask).
//   allow       - silent.
// `default` may be "allow" (git-style allow-by-default), "ask", "deferInAuto", or
// "abstain" (interpreter-style: non-matching invocations fall through untouched).
function evaluate(cfg, args) {
  for (const rule of cfg.deny || []) if (matches(rule, args)) return { decision: 'deny', reason: rule.reason || '' };
  for (const rule of cfg.ask || []) if (matches(rule, args)) return { decision: 'ask', reason: rule.reason || '' };
  for (const rule of cfg.deferInAuto || []) if (matches(rule, args)) return { decision: 'deferInAuto', reason: rule.reason || '' };
  for (const rule of cfg.rewrite || []) if (matches(rule, args)) return { decision: 'rewrite', reason: rule.reason || '', to: rule.to, wrap: rule.wrap, fallbackTo: rule.fallbackTo };
  for (const rule of cfg.allow || []) if (matches(rule, args)) return { decision: 'allow', reason: rule.reason || '' };
  return { decision: cfg.default || 'allow', reason: '' };
}

// Render an argv for a human-facing reason string, with expansion sentinels shown
// as `$(…)` rather than raw NULs.
function display(args) {
  return args.join(' ').split(SUBST).join('$(…)').split(SUBST_Q).join('$(…)');
}

// ---- Main -----------------------------------------------------------------

function main() {
  let payload;
  try { payload = JSON.parse(readStdin()); } catch (_) { process.exit(0); }
  if (!payload || payload.tool_name !== 'Bash') process.exit(0);
  const command = payload.tool_input && payload.tool_input.command;
  if (!command || typeof command !== 'string') process.exit(0);

  const { segments, unparseable } = parse(command);
  const cfgs = loadConfigs();

  // Word-boundary scan for a managed tool name in the raw command — used to scope
  // fail-closed behavior on unparseable input to commands that plausibly involve a
  // managed tool (so benign `x=$(date)` is not gated).
  const managedNames = new Set(Object.keys(cfgs.byTool));
  const mentionsManaged = () => {
    for (const name of managedNames) {
      if (new RegExp(`\\b${name}\\b`).test(command)) return true;
    }
    return false;
  };

  // Worst decision tracked over {allow, deferInAuto, ask, deny} only; rewrite is
  // an allow-level transform tracked separately as splices. Most conservative
  // segment wins: deny > ask > deferInAuto > allow.
  const RANK = { allow: 0, deferInAuto: 1, ask: 2, deny: 3 };
  let worst = { decision: 'allow', reason: '' };
  const bump = (v) => { if (RANK[v.decision] > RANK[worst.decision]) worst = v; };

  const rewrites = [];   // { s, e, to, wrap, fallbackTo } splices into the original command
  let managedCount = 0;
  let unmanagedCount = 0;
  // Whole-command wrap eligibility: every non-rewrite segment must be an allowed
  // segment of a `wrapSafe` (read-only) config, and no segment may redirect
  // output to a real file (inside the wrap that write would land in the sandbox).
  let notWrapSafe = 0;
  const blockers = new Set();
  let fileRedirect = false;
  let nonEmptySegments = 0;

  for (const seg of segments) {
    const argv = stripRedirects(stripEnv(seg));
    if (!argv.length) continue;
    nonEmptySegments++;
    const values = argv.map((t) => t.v);
    for (let k = 0; k < values.length; k++) {
      const m = /^(\d*|&)>>?\|?(.*)$/.exec(values[k]);
      if (!m) continue;
      const target = m[2] || values[k + 1] || '';
      if (target !== '/dev/null') fileRedirect = true;
    }

    // A leading `sh -c` / `bash -c` / `zsh -c` "STRING" hides an opaque inner
    // command. This is a fail-closed (can't-analyze) case -> deferInAuto: prompt
    // interactively, pass through in auto. Only when the raw command mentions a
    // managed tool; otherwise it's an unmanaged shell invocation.
    const base0 = path.basename(values[0]);
    if (['sh', 'bash', 'zsh'].includes(base0) && values.includes('-c')) {
      if (mentionsManaged()) { managedCount++; bump({ decision: 'deferInAuto', reason: `command-policy: '${base0} -c' runs an opaque inner command mentioning a gated tool — approve to run.` }); }
      else unmanagedCount++;
      continue;
    }

    // The command word itself comes out of an expansion (`$(which git) status`):
    // the binary is unknowable, so no config can be resolved -> fail closed, scoped
    // to commands that mention a managed tool (same scoping as `sh -c`).
    if (values[0].includes(SUBST) || values[0].includes(SUBST_Q)) {
      if (mentionsManaged()) { managedCount++; bump({ decision: 'deferInAuto', reason: 'command-policy: command word comes from a shell expansion — cannot resolve the binary; approve to run.' }); }
      else unmanagedCount++;
      continue;
    }

    const real = resolveBinary(values[0]);
    const cfg = configFor(real, values[0], cfgs);
    if (!cfg) { unmanagedCount++; continue; }

    const args = values.slice(1);
    const v = evaluate(cfg, args);

    // An UNQUOTED expansion word-splits, so it can add arbitrary argv tokens and
    // matching is only sound in the positive direction: a rule that DID match still
    // holds, but a rule that did not may have matched the expansion's real value. If
    // this tool has any rule stronger than allow/rewrite, that unknown is a
    // can't-analyze case -> deferInAuto (never rewrite/allow on an argv we cannot
    // see). Tools with no stronger bucket (head, tail, the interpreters) lose
    // nothing, so they stay silent.
    // A QUOTED expansion is deliberately NOT gated: it is exactly one token, which
    // is the same "unknown string, known shape" case as a bare $VAR (also not
    // gated). Gating it would prompt on every `git commit -m "$(cat <<'EOF' …)"`
    // while leaving the equivalent $VAR path open — no real gain, high friction.
    if (args.some((a) => a.includes(SUBST))
        && ((cfg.deny || []).length || (cfg.ask || []).length || (cfg.deferInAuto || []).length)) {
      managedCount++;
      bump({ decision: 'deferInAuto', reason: `command-policy: '${cfg.tool}' takes an argument from a shell expansion — cannot check it against policy; approve to run.` });
      if (v.decision === 'deny' || v.decision === 'ask') bump(v);
      continue;
    }

    // abstain: a managed tool whose specific invocation isn't governed -> treat as
    // pass-through so the normal permission flow handles it (never blanket-allowed).
    if (v.decision === 'abstain') { unmanagedCount++; continue; }

    managedCount++;
    if (v.decision === 'rewrite' && v.to) {
      rewrites.push({ s: argv[0].s, e: argv[0].e, to: v.to, wrap: v.wrap, fallbackTo: v.fallbackTo });
      continue;
    }
    if (!(v.decision === 'allow' && cfg.wrapSafe)) { notWrapSafe++; blockers.add(path.basename(values[0])); }
    if (v.decision !== 'allow' && !v.reason) {
      v.reason = `command-policy: '${cfg.tool} ${display(args)}' requires approval.`;
    }
    bump(v);
  }

  // Unparseable input: fail closed ONLY if a managed tool is mentioned. This is a
  // can't-analyze case -> deferInAuto (prompt interactively, pass through in auto).
  // Substitutions are parsed now, so this is only genuinely unbalanced input.
  if (unparseable && mentionsManaged()) {
    bump({ decision: 'deferInAuto', reason: 'command-policy: command not statically parseable (unterminated quote or expansion) and mentions a gated tool — approve to run.' });
    managedCount++;
  }

  // Decision (tiers, strongest first):
  //  - deny        -> emit (hard block, every permission mode; agent cannot run it).
  //  - ask         -> emit (always prompt, every mode INCLUDING auto — no deferral).
  //  - deferInAuto -> in "auto" mode with COMMAND_POLICY_DEFER_IN_AUTO opt-in,
  //                   abstain (pass through to auto-mode's own flow — no human to
  //                   confirm with in auto). Otherwise (interactive, or flag unset)
  //                   emit `ask` so it still prompts.
  //  - rewrite     -> only when EVERY segment is managed (never greenlight unmanaged
  //                   parts of a compound). Splice command words -> emit allow +
  //                   updatedInput so the boxed command runs with no prompt.
  //  - allow       -> emit explicit allow ONLY when every segment is managed-safe.
  //  - else        -> abstain (normal permission flow).
  if (worst.decision === 'deny') return emit('deny', worst.reason);
  if (worst.decision === 'ask') return emit('ask', worst.reason);
  if (worst.decision === 'deferInAuto') {
    const masterOn = /^(1|true|yes|on)$/i.test(process.env.COMMAND_POLICY_DEFER_IN_AUTO || '');
    if (masterOn && payload.permission_mode === 'auto') return abstain();
    return emit('ask', worst.reason);
  }

  if (rewrites.length && unmanagedCount === 0) {
    const reason = 'command-policy: interpreter inline/scratch code runs sandboxed (no network, repo read-only).';
    const splice = (field) => {
      // Apply splices right-to-left so earlier offsets stay valid.
      const sorted = rewrites.slice().sort((a, b) => b.s - a.s);
      let cmd = command;
      for (const r of sorted) cmd = cmd.slice(0, r.s) + r[field] + cmd.slice(r.e);
      return emit('allow', reason, Object.assign({}, payload.tool_input, { command: cmd }));
    };
    const wrap = rewrites[0].wrap;
    const oneWrap = wrap && rewrites.every((r) => r.wrap === wrap);
    if (!oneWrap) return splice('to');
    // A session whose sandbox predates the shared edge has no `wrap` command on
    // its PATH: keep it on the per-interpreter commands it does have.
    if (!onPath(wrap)) {
      return rewrites.every((r) => r.fallbackTo) ? splice('fallbackTo') : abstain();
    }
    // Several segments sharing one edge: run the whole command inside it, so the
    // pipes between them never cross an edge boundary (nono hangs when the same
    // edge appears twice in one pipeline).
    if (nonEmptySegments > 1 && notWrapSafe === 0 && !fileRedirect) {
      const quoted = "'" + command.replace(/'/g, "'\\''") + "'";
      return emit('allow', reason, Object.assign({}, payload.tool_input, { command: `${wrap} sh -c ${quoted}` }));
    }
    // Can't wrap, and two or more segments would hit the same edge (which hangs):
    // refuse, and tell the agent how to split the command so each call works.
    if (rewrites.length > 1) {
      const why = [];
      if (blockers.size) why.push(`${[...blockers].join(', ')} can't run in the sandbox`);
      if (fileRedirect) why.push('it redirects output to a file, which the sandbox cannot write');
      return emit('deny', [
        `command-policy: split this into separate Bash calls — it runs interpreter code (python/node/perl/awk) more than once, and ${why.join(' and ')}.`,
        `Rules: (1) interpreter code runs sandboxed: no network, repo read-only, writable scratch dir ${SCRATCH_DIR}.`,
        '(2) Several interpreter calls can share one command only when every other step is a read-only tool (cat, ls, grep, rg, jq, sed, sort, uniq, wc, cut, tr, head, tail, find, echo, printf, diff, cd) and nothing redirects to a file.',
        '(3) A single interpreter call can be combined with anything, and can redirect its own output (python3 -c ... > out.txt).',
        '(4) Run git, network tools and file writes in their own call, passing data between calls through a file.',
      ].join(' '));
    }
    return splice('to');
  }

  if (managedCount >= 1 && unmanagedCount === 0) return emit('allow', '');
  return abstain();
}

main();
