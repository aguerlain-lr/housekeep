        "contains": [
          "-E"
        ],
        "notContains": [
          "-i"
        ]
      },
      "to": "sandbox-run perl",
      "reason": "inline perl code auto-boxed (no network, repo read-only)",
      "wrap": "sandbox-run"
    },
    {
      "argv": {
        "scratchScript": true,
        "notContains": [
          "-i"
        ]
      },
      "to": "sandbox-run perl",
