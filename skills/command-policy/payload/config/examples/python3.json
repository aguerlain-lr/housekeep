{
  "tool": "python3",
  "binaries": [
    "/usr/bin/python3"
  ],
  "default": "abstain",
  "rewrite": [
    {
      "argv": {
        "contains": [
          "-c"
        ]
      },
      "to": "sandbox-run python3",
      "reason": "inline python code auto-boxed (no network, repo read-only)",
      "wrap": "sandbox-run"
    },
    {
      "argv": {
        "scratchScript": true
      },
      "to": "sandbox-run python3",
      "reason": "scratch python script auto-boxed (no network, repo read-only)",
      "wrap": "sandbox-run"
    }
  ]
}
